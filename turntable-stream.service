[Unit]
Description=Turntable Streaming Server
After=network.target sound.target

[Service]
Type=simple
User=root
Group=audio
WorkingDirectory=/root/turntable-airplay-sender
ExecStart=/root/turntable-airplay-sender/venv/bin/python3 /root/turntable-airplay-sender/stream_server_v2.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
